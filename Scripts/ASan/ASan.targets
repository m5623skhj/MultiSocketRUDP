<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported only by Invoke-ASan.ps1, after project settings and before C++ targets. -->
  <PropertyGroup>
    <OutDir>$(AsanRoot)\bin\</OutDir>
    <IntDir>$(AsanRoot)\obj\$(MSBuildProjectName)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- Do not fall back to normal, uninstrumented project libraries. -->
      <AdditionalLibraryDirectories>$(OutDir)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
